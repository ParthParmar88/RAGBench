# --- OpenAI ---
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIM=1536

# --- Database ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=ragbench
PG_CONNECTION_USER=postgres
PG_CONNECTION_PASSWORD=root
PG_SCHEMA_NAME=public

# --- Retrieval / chunking ---
# Recommended config from RESULTS.md (exp-004). Delete the four retrieval lines
# below to fall back to the original baseline (vector top-5, no reranking).
TOP_K=8
RERANK_ENABLED=true
RERANK_CANDIDATES=20
MIN_RERANK_SCORE=-2.5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150

# --- CORS (frontend origin) ---
CORS_ORIGINS=http://localhost:5173
